# Production settings for infrastructure/docker/docker-compose.prod.yml.
# Copy to .env.production, fill every value, keep it out of git.

# Public hostnames (DNS A/AAAA records must point at this server)
SITE_DOMAIN=thequeue.example.com
MEDIA_DOMAIN=media.thequeue.example.com

# Generate with: openssl rand -base64 48
SESSION_SECRET=
ENCRYPTION_SECRET=

POSTGRES_USER=thequeue
POSTGRES_PASSWORD=
POSTGRES_DB=thequeue

MINIO_ROOT_USER=thequeue
MINIO_ROOT_PASSWORD=
S3_BUCKET=thequeue-media
GLOBAL_UPLOAD_LIMIT_MB=50

# Transactional email (Postmark, SES, Mailgun, Resend SMTP, ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@thequeue.example.com

# Stripe live keys. Webhook endpoint: https://SITE_DOMAIN/api/v1/payments/webhook
# Events: payment_intent.succeeded, payment_intent.payment_failed,
#         payment_intent.canceled, charge.refunded, charge.dispute.created,
#         charge.dispute.closed, account.updated (enable "Connected accounts" too)
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_
STRIPE_PLATFORM_ACCOUNT_ID=

# First Owner Admin (created on first deploy only; change the password after signing in)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

WORKER_CONCURRENCY=3

# Shown on the Terms and Privacy pages
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_EMAIL=
COPYRIGHT_CONTACT_EMAIL=
LEGAL_MAILING_ADDRESS=
GOVERNING_JURISDICTION=
