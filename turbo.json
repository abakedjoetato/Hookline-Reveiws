{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "TEST_DATABASE_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "PRISMA_*",
    "NODE_ENV",
    "CI",
    "API_INTERNAL_URL",
    "NEXT_PUBLIC_*"
  ],
  "agentGuidance": false
}
