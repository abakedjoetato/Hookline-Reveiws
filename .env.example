# ==============================================================================
# TheQueue - GLOBAL ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# This file contains placeholders and development-default variables.
# NEVER commit real secrets or credentials to this repository.
# For local development, copy this file to '.env' and adjust where necessary.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SHARED INFRASTRUCTURE (Local Docker default configs)
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL Connection String (Native PostgreSQL type)
DATABASE_URL=postgresql://postgres:local_postgres_secret_123@localhost:5432/thequeue_dev?schema=public

# Redis Broker URL (ioredis and BullMQ compatible)
REDIS_URL=redis://localhost:6379

# MinIO Local S3 configuration
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=thequeue-media-local
S3_ACCESS_KEY=local_minio_admin
S3_SECRET_KEY=local_minio_secret_123
S3_FORCE_PATH_STYLE=true

# Mailpit SMTP connection parameters
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=noreply@thequeue.com

# ------------------------------------------------------------------------------
# 2. PUBLIC BROWSER ENVIRONMENT (Safe for Next.js client-side bundles)
# ------------------------------------------------------------------------------
# NOTE: Next.js variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# DO NOT include database credentials, private API keys, or JWT keys here.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_HOST_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_thequeue_51Px871638201

# ------------------------------------------------------------------------------
# 3. BACKEND API SECRETS (Only loaded on apps/api server process)
# ------------------------------------------------------------------------------
PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
ENABLE_SWAGGER=true

# Cryptographically secure secrets (Min 32 characters)
SESSION_SECRET=local_session_rotation_secret_value_32_chars_long
ENCRYPTION_SECRET=local_database_field_encryption_secret_32_chars

# Stripe Gateway Credentials
STRIPE_SECRET_KEY=sk_test_thequeue_secret_key_123
STRIPE_WEBHOOK_SECRET=whsec_thequeue_webhook_signing_secret_123

# ------------------------------------------------------------------------------
# 4. WORKER CONFIGURATION (Only loaded on apps/worker)
# ------------------------------------------------------------------------------
# Worker doesn't expose a public port, but serves health/metrics internally on 4001
WORKER_PORT=4001
WORKER_CONCURRENCY=5

# ------------------------------------------------------------------------------
# 5. TEST-SPECIFIC VARIABLES (Used during Vitest/Playwright runs)
# ------------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://postgres:local_postgres_secret_123@localhost:5432/thequeue_test?schema=public
TEST_REDIS_URL=redis://localhost:6379/1
