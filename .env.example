# Local development. Copy to .env and run: npm run infrastructure:up
# Values match infrastructure/docker/docker-compose.yml.

NODE_ENV=development
DATABASE_URL=postgresql://postgres:local_postgres_secret_123@localhost:5432/thequeue_dev
REDIS_URL=redis://localhost:6379

# Web app URL (email links, Stripe return URLs) and allowed browser origins
NEXT_PUBLIC_WEB_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Next dev server proxies /api/v1 and /socket.io here
API_INTERNAL_URL=http://localhost:4000
# Set to "/" to use live websockets through the dev proxy; empty = 5s polling
NEXT_PUBLIC_WS_URL=

# At least 32 characters each
SESSION_SECRET=dev-session-secret-change-me-0123456789
ENCRYPTION_SECRET=dev-encryption-secret-change-me-012345

# MinIO (S3-compatible) from docker-compose
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=thequeue-media-local
S3_ACCESS_KEY=local_minio_admin
S3_SECRET_KEY=local_minio_secret_123
S3_FORCE_PATH_STYLE=true
GLOBAL_UPLOAD_LIMIT_MB=50

# Mailpit catches all email: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@thequeue.local

# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Local only: lets host onboarding finish without a real Stripe Connect account.
# Ignored when NODE_ENV=production.
STRIPE_CONNECT_DEV_BYPASS=true

# First Owner Admin, created once by `npm run db:seed`
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_USERNAME=owner
ADMIN_BOOTSTRAP_PASSWORD=Change-Me-Owner-123

WORKER_PORT=4001
WORKER_CONCURRENCY=2
LOG_LEVEL=debug

# Shown on the Terms and Privacy pages
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_EMAIL=
COPYRIGHT_CONTACT_EMAIL=
LEGAL_MAILING_ADDRESS=
GOVERNING_JURISDICTION=
